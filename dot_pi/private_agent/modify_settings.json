{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $packages := list
  "npm:pi-web-access"
  "npm:pi-subagents"
  "npm:@aliou/pi-processes"
  "npm:pi-goal-x"
  "npm:pi-daybreak-param"
-}}
{{ $settings | setValueAtPath "packages" $packages | setValueAtPath "fullscreenWheelScrollLines" "auto" | toPrettyJson -}}
