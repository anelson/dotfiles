{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $packages := list
  "npm:pi-web-access"
  "npm:pi-subagents"
  "npm:pi-background-tasks"
  "npm:pi-goal-x"
-}}
{{ $settings | setValueAtPath "packages" $packages | setValueAtPath "fullscreenWheelScrollLines" 15 | toPrettyJson -}}
